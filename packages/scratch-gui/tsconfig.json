{
    "include": [
        "src"
    ],
    "compilerOptions": {
        "target": "ESNext",
        "jsx": "react",
        "module": "commonjs",
        "types": [
            "./src/types.d.ts"
        ],
        "declaration": true,
        "sourceMap": true,
        "outDir": "./dist/types/",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "rootDir": "./src"
    },
    "exclude": [
        "dist",
        "node_modules"
    ]
}